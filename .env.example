# Chat Completions client configuration. Set these variables in your shell.
# .env files are not loaded automatically. Do not commit real API keys.
# Base URL should include /v1 if the provider requires it (not /chat/completions).
OPENAI_BASE_URL=
# Optional for local servers that do not require authentication.
OPENAI_API_KEY=
# Choose a model available to you with function calling support.
# Plan Mode also requires JSON Schema response_format support from the server.
OPENAI_MODEL=
# Optional request timeout; increase for a local model (default: 60 seconds).
OPENAI_TIMEOUT_SECONDS=60

