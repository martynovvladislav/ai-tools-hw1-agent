{
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "steps", "risks", "assumptions", "done_when"],
  "properties": {
    "goal": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "description", "tools", "depends_on", "expected_result"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
          "description": {"type": "string", "minLength": 1},
          "tools": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "enum": ["list_files", "read_file", "write_file", "Bash"]}
          },
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "expected_result": {
            "type": "object", "additionalProperties": false,
            "required": ["description", "checks"],
            "properties": {
              "description": {"type": "string", "minLength": 1},
              "checks": {
                "type": "array", "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object", "additionalProperties": false, "required": ["tool"],
                      "properties": {
                        "tool": {"type": "string", "enum": ["list_files", "read_file", "write_file"]},
                        "path": {"type": "string", "minLength": 1}
                      }
                    },
                    {
                      "type": "object", "additionalProperties": false, "required": ["tool"],
                      "properties": {"tool": {"type": "string", "const": "Bash"}}
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "done_when": {"type": "string", "minLength": 1}
  }
}
